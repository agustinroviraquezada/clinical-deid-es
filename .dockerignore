# Keep the build context small and free of secrets: only what the Dockerfile copies is needed.
.git
.github
.claude
.devcontainer
.venv
.pytest_cache
.ruff_cache
**/__pycache__
.env
.env.*
data/
models/
model/
notebooks/
tests/
docs/
specs/
scripts/
infra/
*.safetensors
*.bin
*.pt
*.onnx

# Exception: the model folder downloaded by deploy.yml goes into the image (design §5). Only the
# files the app needs; no pickled .bin files.
!model/config.json
!model/model.safetensors
!model/tokenizer.json
!model/tokenizer_config.json
